@InventoryAPI_HostAddress = http://localhost:5184

GET {{InventoryAPI_HostAddress}}/weatherforecast/
Accept: application/json

###

GET {{InventoryAPI_HostAddress}}/api/roles
Accept: application/json

###

GET {{InventoryAPI_HostAddress}}/api/roles/1
Accept: application/json

###

POST {{InventoryAPI_HostAddress}}/api/roles
Content-Type: application/json

{
  "rolesName": "Administrador",
  "rolesDescription": "Acceso total"
}

###

PUT {{InventoryAPI_HostAddress}}/api/roles/1
Content-Type: application/json

{
  "rolesName": "Administrador",
  "rolesDescription": "Acceso total al inventario",
  "isActive": true
}

###

POST {{InventoryAPI_HostAddress}}/api/usuarios
Content-Type: application/json

{
  "nombreCompleto": "Ana Pérez",
  "email": "ana@inventario.local",
  "password": "ClaveSegura1",
  "roleId": 1
}

###

POST {{InventoryAPI_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "ana@inventario.local",
  "password": "ClaveSegura1"
}

###

GET {{InventoryAPI_HostAddress}}/api/usuarios
Authorization: Bearer {{token}}
Accept: application/json

